+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// Knowl: the mascot, an ink-line owl wearing a lime-rimmed visor, and the "Knowl" wordmark.
+// The same drawing as Knowable Labs' dashboard (dashboard/web/src/components/Logo.tsx).
+
+import React from 'react';
+import styled from 'styled-components';
+
+const BODY = 'M4 7 L2.5 1.5 L7.5 5 H16.5 L21.5 1.5 L20 7 A10 10 0 0 1 22 13 V18 A10 9 0 0 1 2 18 V13 A10 10 0 0 1 4 7 Z';
+const WINGS = 'M5.5 15 C5 19 6 23 8.5 26 M18.5 15 C19 19 18 23 15.5 26';
+const BEAK = 'M10.6 14 L12 16.6 L13.4 14';
+const VISOR = 'M2.8 8.5 Q12 7.2 21.2 8.5 L20.2 12.1 Q19.8 13.4 18.3 13.5 L14.5 13.5 Q13.4 13.5 12 12.3 Q10.6 13.5 9.5 13.5 L5.7 13.5 Q4.2 13.4 3.8 12.1 Z';
+const LIME = '#c6da3a';
+
+type Props = {width?: number; ink?: string};
+
+export const Owl = ({width = 22, ink = 'currentColor'}: Props) => (
+    <svg
+        width={width}
+        height={(width * 28) / 24}
+        viewBox='0 0 24 28'
+        aria-hidden='true'
+
+        // Inline, so a surrounding `svg { width }` rule (the sign-in header has one) cannot
+        // stretch the owl.
+        style={{width, height: (width * 28) / 24, flex: 'none'}}
+    >
+        <g
+            fill='none'
+            stroke={ink}
+            strokeWidth='1.7'
+            strokeLinejoin='round'
+            strokeLinecap='round'
+        >
+            <path d={BODY}/>
+            <path d={WINGS}/>
+            <path d={BEAK}/>
+        </g>
+        <path
+            d={VISOR}
+            fill='#14252c'
+            stroke={LIME}
+            strokeWidth='1.1'
+            strokeLinejoin='round'
+        />
+        <path
+            d='M6.2 9.5 L8.7 9.2 L6.6 12 H5.4 Z M9.8 9.1 L10.7 9 L8.7 11.8 H7.8 Z'
+            fill='#9edce0'
+            fillOpacity='0.7'
+        />
+    </svg>
+);
+
+const Mark = styled.span`
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    color: inherit;
+`;
+
+const Name = styled.span`
+    font-family: 'Public Sans', sans-serif;
+    font-size: 16px;
+    font-weight: 600;
+    line-height: 24px;
+    letter-spacing: -0.01em;
+`;
+
+const By = styled.span`
+    font-family: 'Public Sans', sans-serif;
+    font-size: 12px;
+    font-weight: 400;
+    opacity: 0.64;
+`;
+
+export const KnowlMark = ({width = 20, by = false}: {width?: number; by?: boolean}) => (
+    <Mark>
+        <Owl width={width}/>
+        <Name>{'Knowl'}</Name>
+        {by && <By>{'by Knowable Labs'}</By>}
+    </Mark>
+);
