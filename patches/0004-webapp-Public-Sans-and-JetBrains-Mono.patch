From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Knowable Labs <knowl@knowl.invalid>
Date: Wed, 21 Oct 2026 18:57:07 -0700
Subject: [PATCH 4/8] webapp: Public Sans and JetBrains Mono

The font files and the rename of 'Open Sans' and Metropolis are applied
by knowablelabs' build (dashboard/agent/mattermost/build.sh).
---
 .../channels/src/sass/base/_typography.scss   | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/webapp/channels/src/sass/base/_typography.scss b/webapp/channels/src/sass/base/_typography.scss
index cde6d900..8716b64c 100644
--- a/webapp/channels/src/sass/base/_typography.scss
+++ b/webapp/channels/src/sass/base/_typography.scss
@@ -237,3 +237,38 @@ ol {
         text-decoration: underline;
     }
 }
+
+/* Knowl: Public Sans for text and JetBrains Mono for code (SIL Open Font License 1.1). The
+   files are copied in by knowablelabs' dashboard/agent/mattermost/build.sh, and its transform
+   points every 'Open Sans' and Metropolis declaration at Public Sans. */
+@font-face {
+    font-display: swap;
+    font-family: 'Public Sans';
+    font-style: normal;
+    font-weight: 100 900;
+    src: url('../fonts/knowl/public-sans-latin-wght-normal.woff2') format('woff2-variations');
+}
+
+@font-face {
+    font-display: swap;
+    font-family: 'Public Sans';
+    font-style: italic;
+    font-weight: 100 900;
+    src: url('../fonts/knowl/public-sans-latin-wght-italic.woff2') format('woff2-variations');
+}
+
+@font-face {
+    font-display: swap;
+    font-family: 'JetBrains Mono';
+    font-style: normal;
+    font-weight: 100 800;
+    src: url('../fonts/knowl/jetbrains-mono-latin-wght-normal.woff2') format('woff2-variations');
+}
+
+@font-face {
+    font-display: swap;
+    font-family: 'JetBrains Mono';
+    font-style: italic;
+    font-weight: 100 800;
+    src: url('../fonts/knowl/jetbrains-mono-latin-wght-italic.woff2') format('woff2-variations');
+}
