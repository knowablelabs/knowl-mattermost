+        const {lastChannelPath, isCollapsedThreadsEnabled, isMobileView, pluginsEnabled} = this.props;
         const url = this.props.match.url;

         return (
@@ -86,6 +86,10 @@ export default class CenterChannel extends React.PureComponent<Props, State> {
                 {isMobileView && <MobileChannelHeader/>}
                 <div className='row main'>
                     <Switch>
+                        {/* The full Knowable Labs plugin owns the research landing screen. */}
+                        {!pluginsEnabled && <Route exact={true} path={`${url}/channels/town-square`}>
+                            <Redirect to={`${url}/messages/@knowl`}/>
+                        </Route>}
                         <Route
                             path={`${url}/pl/:postid(${ID_PATH_PATTERN})`}
                             render={(props) => (
