 }
 
+const ENGLISH_ONLY: boolean = true;
+
 export function getLanguages(state: GlobalState) {
     const config = getConfig(state);
+
+    // Knowl: "Topic" is written into the English strings alone (transform.mjs), so English
+    // is the one language offered whatever the server lists.
+    if (ENGLISH_ONLY) {
+        return {en: languages.en};
+    }
     if (!config.AvailableLocales) {
         return getAllLanguages(config.EnableExperimentalLocales === 'true');
     }
