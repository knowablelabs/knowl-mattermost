diff --git a/server/channels/app/permissions_migrations.go b/server/channels/app/permissions_migrations.go
index 620129dc..af5b16e3 100644
--- a/server/channels/app/permissions_migrations.go
+++ b/server/channels/app/permissions_migrations.go
@@ -1329,6 +1329,43 @@ func (a *App) getAddEditFileAttachmentPermissionMigration() (permissionsMap, err
 	}, nil
 }
 
+// Knowl: a workspace's team, Topics and their members are the research service's to
+// manage. A member cannot rename, archive or re-describe a Topic, change who is in it,
+// start a group message or make another team; the webapp hides what a role does not
+// grant. Administrators keep all of it. Editing and deleting one's own message stay
+// granted, because agents revise their own posts; the webapp withholds those from people.
+func (a *App) getKnowlWorkspaceControlsMigration() (permissionsMap, error) {
+	return permissionsMap{
+		permissionTransformation{
+			On: isRole(model.ChannelUserRoleId),
+			Remove: []string{
+				model.PermissionManagePublicChannelProperties.Id,
+				model.PermissionManagePrivateChannelProperties.Id,
+				model.PermissionDeletePublicChannel.Id,
+				model.PermissionDeletePrivateChannel.Id,
+				model.PermissionManagePublicChannelMembers.Id,
+				model.PermissionManagePrivateChannelMembers.Id,
+			},
+		},
+		// Whoever a Topic or the team was made for is its administrator, and those
+		// roles grant membership a second time.
+		permissionTransformation{
+			On: permissionOr(isRole(model.ChannelAdminRoleId), isRole(model.TeamAdminRoleId)),
+			Remove: []string{
+				model.PermissionManagePublicChannelMembers.Id,
+				model.PermissionManagePrivateChannelMembers.Id,
+			},
+		},
+		permissionTransformation{
+			On: isRole(model.SystemUserRoleId),
+			Remove: []string{
+				model.PermissionCreateTeam.Id,
+				model.PermissionCreateGroupChannel.Id,
+			},
+		},
+	}, nil
+}
+
 func (a *App) getAddDiscoverableChannelPermissionsMigration() (permissionsMap, error) {
 	return permissionsMap{
 		permissionTransformation{
@@ -1408,6 +1445,7 @@ func (s *Server) doPermissionsMigrations() error {
 		{Key: model.MigrationKeyAddManageAgentPermissions, Migration: a.getAddManageAgentPermissionsMigration},
 		{Key: model.MigrationKeyAddEditFileAttachmentPermission, Migration: a.getAddEditFileAttachmentPermissionMigration},
 		{Key: model.MigrationKeyAddDiscoverableChannelPermissions, Migration: a.getAddDiscoverableChannelPermissionsMigration},
+		{Key: model.MigrationKeyKnowlWorkspaceControls, Migration: a.getKnowlWorkspaceControlsMigration},
 	}
 
 	roles, err := s.Store().Role().GetAll()
